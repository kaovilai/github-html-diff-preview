{
  "name": "github-html-preview",
  "version": "0.1.0",
  "private": true,
  "description": "Browser extension that previews HTML files and rendered HTML diffs on GitHub, entirely locally.",
  "license": "MIT",
  "author": "kaovilai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaovilai/github-html-preview.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:chrome": "node scripts/build.mjs chrome",
    "build:firefox": "node scripts/build.mjs firefox",
    "zip": "node scripts/build.mjs && node scripts/zip.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "node scripts/build.mjs chrome && playwright test --project=e2e",
    "test:a11y": "node scripts/build.mjs chrome && playwright test --project=a11y",
    "check": "npm run typecheck && npm run lint && npm test",
    "icons": "node scripts/make-icons.mjs",
    "store-assets": "node scripts/store-assets.ts",
    "source-zip": "mkdir -p dist && git archive --format=zip --output dist/github-html-preview-source.zip HEAD"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "fflate": "^0.8.3",
    "jsdom": "^30.1.3",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
