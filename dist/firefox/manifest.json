{
  "manifest_version": 3,
  "name": "GitHub HTML Diff Preview",
  "short_name": "HTML Diff Preview",
  "version": "0.2.1",
  "description": "Preview HTML files on GitHub and see rendered before/after diffs in pull requests. Runs entirely in your browser.",
  "permissions": [
    "contextMenus"
  ],
  "host_permissions": [
    "https://github.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "GitHub HTML Diff Preview"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "viewer/viewer.html"
      ],
      "matches": [
        "https://github.com/*"
      ]
    }
  ],
  "commands": {
    "preview": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "Alt+Shift+P"
      },
      "description": "Preview the HTML file on this GitHub page"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "github-html-diff-preview@kaovilai.github.io",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
